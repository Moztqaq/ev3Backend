# Copy this file to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_HSTS_SECONDS=0
# Enable HTTPS redirects, secure cookies, and HSTS only after HTTPS is verified.

# SQLite is used when DB_ENGINE is omitted.
# Production PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=petcare
# DB_USER=petcare_app
# DB_PASSWORD=replace-with-a-strong-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require

# Email reminders are disabled until EMAIL_HOST is configured.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=petcare@example.com
# EMAIL_HOST_PASSWORD=replace-with-an-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=PetCare <petcare@example.com>
